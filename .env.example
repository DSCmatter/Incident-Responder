# Copy to .env and fill in what you have. Nothing here is required for `make test`.
# Gemini API key from https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=
# OpenRouter key from https://openrouter.ai/keys (free models only, no credits needed).
OPENROUTER_API_KEY=
# Local Ollama exposes an OpenAI-compatible endpoint by default.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Override config.yaml without editing it.
# INCIDENT_LLM_MODE=replay
# INCIDENT_LLM_CHAIN=ollama
